#!/bin/bash
# Install base packages based on OS

set -e

# All three shells this repo configures are installed everywhere, not just the
# one picked as the login shell at `chezmoi init`. The bash, zsh and fish configs
# are deployed regardless, and switching between them should cost a chsh rather
# than another apply.

{{ if eq .chezmoi.os "darwin" }}
# macOS: Install via Homebrew
if ! command -v brew &> /dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Add Homebrew to PATH for Apple Silicon
if [ -d "/opt/homebrew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "Installing packages via Homebrew..."
brew install git vim tmux zsh fish curl coreutils

{{ else if eq .chezmoi.os "linux" }}
# Detect Linux distribution
if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO=$ID
else
    DISTRO="unknown"
fi

case "$DISTRO" in
    debian|ubuntu)
        echo "Installing packages via apt..."
        sudo apt update
        sudo apt install -y git vim tmux zsh fish curl
        # Desktop packages (Wayland/Sway)
        if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ] || [ -n "$XDG_SESSION_TYPE" ]; then
            sudo apt install -y sway wofi mako-notifier kitty grim slurp wl-clipboard swaylock swayidle swaybg
            # ~/.config/sway/bar.sh takes quickshell when it is there and waybar
            # otherwise. Debian and Ubuntu package neither quickshell nor a way to
            # build it without work, so waybar is what gets installed here. Build
            # quickshell from https://quickshell.outfoxxed.me to switch; bar.sh
            # picks it up on the next sway reload.
            command -v qs >/dev/null || sudo apt install -y waybar
        fi
        ;;
    fedora)
        echo "Installing packages via dnf..."
        sudo dnf install -y git vim tmux zsh fish curl
        # Desktop packages (Wayland/Sway)
        if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ] || [ -n "$XDG_SESSION_TYPE" ]; then
            sudo dnf install -y sway wofi mako kitty grim slurp wl-clipboard swaylock swayidle swaybg
            # quickshell lives in the errornointernet/quickshell COPR rather than
            # in Fedora proper, so waybar is the bar here. Enable that COPR and
            # ~/.config/sway/bar.sh switches over on the next sway reload.
            command -v qs >/dev/null || sudo dnf install -y waybar
        fi
        ;;
    arch|manjaro|cachyos)
        echo "Installing packages via pacman..."
        sudo pacman -Syu --noconfirm git vim tmux zsh fish curl
        # Desktop packages (Wayland/Sway). The list lives in
        # .chezmoidata/packages.toml, which install-sway.sh reads as well.
        if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ] || [ -n "$XDG_SESSION_TYPE" ]; then
            sudo pacman -S --needed --noconfirm \
                {{ .packages.arch.core | join " " }} \
                {{ .packages.arch.tools | join " " }} \
                {{ .packages.arch.desktop | join " " }}
            # quickshell is in packages.arch.core, so this only fires when that
            # install failed or the package left the repositories. bar.sh needs
            # one of the two to exist or the session comes up without a bar.
            command -v qs >/dev/null || command -v waybar >/dev/null || \
                sudo pacman -S --needed --noconfirm waybar
        fi
        ;;
    nixos)
        echo "NixOS detected - packages managed via flake configuration"
        echo "Run: sudo nixos-rebuild switch --flake ~/workbuddy/chezmoi/nixos#legion"
        ;;
    *)
        echo "Unknown distribution: $DISTRO"
        echo "Please install packages manually: git vim tmux zsh curl"
        ;;
esac
{{ end }}

echo "Package installation complete!"
