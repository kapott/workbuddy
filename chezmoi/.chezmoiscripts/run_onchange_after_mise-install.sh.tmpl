#!/bin/bash
# Install/sync mise tools when the global config changes
# hash: {{ include "private_dot_config/private_mise/config.toml" | sha256sum }}

set -e

# Ensure mise is in PATH
export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise &> /dev/null; then
    echo "mise not found, skipping tool installation"
    exit 0
fi

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"

echo "Installing mise tools from $CONFIG..."

# Trust the config file
mise trust "$CONFIG" 2>/dev/null || true

# Install all tools
mise install

echo "mise tools installed successfully!"
mise list
