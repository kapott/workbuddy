[user]
	name = {{ .name }}
	email = {{ .email }}

[init]
	defaultBranch = main

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else if stat "/usr/lib/git-core/git-credential-libsecret" }}
	# Talks to org.freedesktop.secrets, which ksecretd owns on this machine and
	# the pam_kwallet handover unlocks at login, so pushes stop asking without a
	# token sitting in cleartext. Ships with git itself on Arch; git finds it in
	# its exec path, so the bare name is enough.
	helper = libsecret
{{- else }}
	# No secret service found at render time. cache keeps the token in a daemon's
	# memory for 15 minutes and writes nothing to disk, which beats `store`.
	# Install libsecret support and re-apply to switch.
	helper = cache --timeout=900
{{- end }}

[push]
	default = simple

[pull]
	rebase = false

[core]
	editor = vim
	whitespace = fix, -indent-with-non-tab,trailing-space,cr-at-eol

[color]
	ui = true

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = red

[alias]
	a = add
	b = branch
	c = commit
	d = diff
	f = fetch
	m = merge
	p = pull
	pu = push
	st = status
	u = reset HEAD --
	co = checkout
	sl = stash list
	sa = stash apply
	ss = stash save
	sd = stash drop stash@{0}
	unstage = reset HEAD --

[url "https://github.com/"]
	insteadOf = gh:

[url "https://gist.github.com/"]
	insteadOf = gist:

[url "https://bitbucket.org/"]
	insteadOf = bb:

[url "https://gitlab.com"]
	insteadOf= gl:
