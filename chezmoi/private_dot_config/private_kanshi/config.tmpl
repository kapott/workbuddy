{{ if eq .chezmoi.hostname "endling" -}}
# Display profiles for endling (ROG Flow Z13 GZ302EAC).
#
# sway already applies its own `output` blocks when an output shows up, so this
# only earns its place for the docked case, where the layout differs from the
# sum of the individual outputs. kanshi picks the first profile whose listed
# outputs all match what is connected.

profile docked {
    output DP-5 enable mode 3840x1600@119.980Hz position 0,0 scale 1
    output eDP-1 enable mode 2560x1600@180.000Hz position 3840,320 scale 1.25
}

profile tablet {
    output eDP-1 enable mode 2560x1600@180.000Hz position 0,0 scale 1.25
}
{{- end }}
