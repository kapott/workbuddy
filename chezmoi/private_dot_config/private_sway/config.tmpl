# Sway config
#
# Host-specific blocks are keyed on .chezmoi.hostname. Everything outside those
# blocks is shared. Run `swaymsg -t get_outputs` and `swaymsg -t get_inputs` on a
# new machine before adding a block for it.

### Variables

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu wofi --show drun
set $lock swaylock -f

font pango:Hack Nerd Font 11

# XDG_PICTURES_DIR is Pictures on this user; screenshots go one level down.
set $shots ~/Pictures/Screenshots

{{ if eq .chezmoi.hostname "endling" -}}
### Outputs: ASUS ROG Flow Z13 GZ302EAC
#
# eDP-1 is the 13.4" 2560x1600 tablet panel, 226 DPI. Scale 1.25 gives 2048x1280
# logical, which is what Plasma was already using. Fractional scale makes
# XWayland clients render blurry; set scale 1 if that bothers you more than the
# small text does.
#
# DP-5 is the 3840x1600 ultrawide. Its EDID lists a 144Hz mode but advertises
# 119.98 as preferred, so that is what is set here.

# Catch-all first, so an output that is neither of the two named below still
# gets a background instead of swaybg logging "Could not find config for output"
# and leaving it undrawn. Later blocks win.
output * bg #2e2e2e solid_color

output DP-5 {
    mode 3840x1600@119.980Hz
    position 0 0
    scale 1
    bg #2e2e2e solid_color
}

output eDP-1 {
    mode 2560x1600@180.000Hz
    position 3840 320
    scale 1.25
    bg #2e2e2e solid_color
}

# Wallpaper, only if one is actually present. `output * bg <missing file>` is a
# config error in sway and aborts the rest of the file.
exec_always test -f ~/.wallpaper && swaymsg output '*' bg ~/.wallpaper fill

### Inputs: Z13

# Touchscreen and stylus must be pinned to the built-in panel, otherwise taps
# land on the ultrawide.
input type:touch {
    map_to_output eDP-1
}

input type:tablet_tool {
    map_to_output eDP-1
}

# Detachable keyboard cover.
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    scroll_method two_finger
    accel_profile adaptive
}

# MX Master 3S and the Adv360 Pro mouse mode. Flat accel, no natural scroll:
# opposite of the touchpad on purpose.
input type:pointer {
    natural_scroll disabled
    accel_profile flat
}

### Switches: Z13
#
# The Asus WMI hotkeys device exposes SW_TABLET_MODE (SW=2 in
# /proc/bus/input/devices), so detaching the keyboard cover fires this.
bindswitch --reload --locked tablet:on  exec ~/.config/sway/tablet-mode.sh on
bindswitch --reload --locked tablet:off exec ~/.config/sway/tablet-mode.sh off

# Lid close only blanks the panel when a second output is still up. Without the
# guard, closing the cover on the road leaves you with no screen at all.
bindswitch --reload --locked lid:on  exec ~/.config/sway/lid.sh close
bindswitch --reload --locked lid:off exec ~/.config/sway/lid.sh open

### Rotation
# iio-sensor-proxy is installed; this follows accel_3d and remaps touch to match.
exec ~/.config/sway/autorotate.sh
{{- else -}}
### Outputs: unknown host, safe defaults
output * bg #2e2e2e solid_color
exec_always test -f ~/.wallpaper && swaymsg output '*' bg ~/.wallpaper fill

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}
{{- end }}

input type:keyboard {
    xkb_layout us
    xkb_options compose:ralt
    repeat_delay 250
    repeat_rate 40
}

### Idle and lock

exec swayidle -w \
    timeout 300  '$lock' \
    timeout 600  'swaymsg "output * power off"' \
        resume   'swaymsg "output * power on"' \
    before-sleep '$lock'

bindsym $mod+Ctrl+l exec $lock

### Keys: launching

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

floating_modifier $mod normal

### Keys: focus and movement

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

workspace_auto_back_and_forth yes

{{ if eq .chezmoi.hostname "endling" -}}
# Default homes for the two outputs. Sway falls back to the focused output when
# the named one is absent, so this is safe undocked.
workspace $ws1 output DP-5 eDP-1
workspace $ws2 output DP-5 eDP-1
workspace $ws3 output DP-5 eDP-1
workspace $ws4 output DP-5 eDP-1
workspace $ws9 output eDP-1 DP-5
workspace $ws10 output eDP-1 DP-5
{{- end }}

bindsym $mod+Ctrl+greater move workspace to output right
bindsym $mod+Ctrl+less move workspace to output left
bindsym $mod+Ctrl+Right focus output right
bindsym $mod+Ctrl+Left focus output left

### Displays
#
# display.sh only talks to the running sway. kanshi keeps owning hotplug, so
# replugging returns to the profile in ~/.config/kanshi/config.

bindsym $mod+p exec ~/.config/sway/display.sh menu
bindsym $mod+Shift+p exec ~/.config/sway/display.sh internal-only

### Layout

bindsym $mod+minus splitv
bindsym $mod+bar splith
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+z fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+f focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+comma scratchpad show

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

### Gestures
#
# Carried over from ~/.config/libinput-gestures.conf: four fingers sideways used
# to switch desktops under Plasma, so they switch workspaces here. Three-finger
# back/forward cannot be done globally in sway, so those slots do window things.

bindgesture swipe:4:right workspace prev
bindgesture swipe:4:left workspace next
bindgesture swipe:3:up fullscreen toggle
bindgesture swipe:3:down floating toggle

### Screenshots

bindsym Print exec grim - | wl-copy
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+Print exec mkdir -p $shots && grim -g "$(slurp)" "$shots/$(date +%Y%m%d-%H%M%S).png"

### Media and hardware keys

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

{{ if eq .chezmoi.hostname "endling" -}}
# Z13 keyboard cover backlight, via the asus::kbd_backlight LED.
bindsym --locked XF86KbdBrightnessUp exec brightnessctl -d asus::kbd_backlight set +1
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -d asus::kbd_backlight set 1-

# ASUS fan/performance profile. asusd owns the actual switching; the script wraps
# asusctl so this binding and the bar indicator cannot drift apart, and so a CLI
# rename breaks one file instead of two. It also refreshes the bar on the spot,
# by rewriting the state file the indicator watches.
bindsym XF86Launch4 exec ~/.config/sway/power-profile.sh next
# ROG key opens the vendor control centre.
bindsym XF86Launch1 exec rog-control-center

# On-screen keyboard, for when the cover is off.
bindsym $mod+o exec ~/.config/sway/toggle-osk.sh
{{- end }}

### Clipboard history

bindsym $mod+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

### Appearance

gaps inner 8
gaps outer 0
default_border pixel 3
default_floating_border pixel 3
hide_edge_borders smart
smart_borders on
title_align center

# Monokai-inspired, matching the quickshell and mako palettes.
set $background #2e2e2e
set $comment    #797979
set $white      #d6d6d6
set $orange     #fd971f
set $pink       #f92672

# class                 border      background  text     indicator  child_border
client.focused          $orange     $background $orange  $orange    $orange
client.focused_inactive $background $background $white   #484e50    #5f676a
client.unfocused        $background $background $comment #292d2e    #222222
client.urgent           $pink       $pink       $white   $pink      $pink

seat seat0 xcursor_theme Adwaita 24

### Window rules
#
# Electron and Chromium apps land on XWayland unless forced into Wayland mode, so
# each one is matched on both app_id and class.

assign [app_id="firefox"] $ws1
assign [app_id="chromium"] $ws1
assign [app_id="google-chrome"] $ws1
assign [app_id="obsidian"] $ws3
assign [class="obsidian"] $ws3
assign [app_id="codium"] $ws4
assign [class="VSCodium"] $ws4
assign [app_id="signal"] $ws5
assign [class="Signal"] $ws5

for_window [app_id="pavucontrol"] floating enable, resize set 900 600
for_window [app_id="blueman-manager"] floating enable, resize set 900 600
for_window [app_id="rog-control-center"] floating enable
for_window [app_id="org.kde.polkit-kde-authentication-agent-1"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable

# Screen-share picker from xdg-desktop-portal-wlr.
for_window [app_id="^.*"] inhibit_idle fullscreen

### Startup

# quickshell if it is installed, waybar otherwise. bar.sh decides at start, not
# chezmoi at apply, so installing the other one takes a reload and no re-apply.
exec_always ~/.config/sway/bar.sh

# autotiling picks the split direction from the focused window's shape, which is
# what makes an ultrawide usable without constant Mod+minus / Mod+bar. Optional:
# if the package is missing this line just fails quietly.
exec_always "pkill -x autotiling; autotiling"
exec mako
exec /usr/lib/polkit-kde-authentication-agent-1
exec wl-paste --watch cliphist store
exec nm-applet --indicator
exec blueman-applet
exec kanshi

# Finish the kwallet PAM handover. pam_kwallet5 in /usr/lib/pam.d/plasmalogin
# already started ksecretd holding the login password and left a socket at
# $XDG_RUNTIME_DIR/kwallet5.socket, but the daemon does nothing until
# pam_kwallet_init connects to it. Upstream ships that step as an XDG autostart
# entry and a systemd unit that is PartOf=graphical-session.target, and sway runs
# neither, so without this line the wallet stays shut and every app that wants a
# secret activates a second, locked daemon and prompts for a password.
# Harmless when the socket is absent, which is what a TTY login looks like.
exec test -S "$XDG_RUNTIME_DIR/kwallet5.socket" && /usr/lib/pam_kwallet_init

# Floor under kanshi: if an output event ever leaves sway with nothing enabled,
# turn the internal panel back on. `external-only` plus an unplugged cable is the
# way to get there, and once there no keybinding can help because nothing draws.
exec ~/.config/sway/panel-guard.sh

# Hand the session environment to systemd and the portals, otherwise screen
# sharing and any systemd user unit that needs WAYLAND_DISPLAY come up blind.
# The script refuses to do it when this sway is nested inside another
# compositor, because the systemd user manager is shared per user and an
# unguarded import leaves the host session pointing at a dead socket after sway
# quits. See the comment at the top of session-env.sh.
exec ~/.config/sway/session-env.sh

# Deliberately not including /etc/sway/config.d/*. The only file Arch ships
# there, 50-systemd-user.conf, runs exactly the unguarded import described
# above, so including it would reintroduce the bug that session-env.sh exists to
# avoid. If a distro adds something else worth having, copy it in here on
# purpose rather than sourcing the directory wholesale.
