#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03
#
# Copied into every new repo by init.templateDir (~/.git-template, managed by
# workbuddy), and into existing ones by running `git init` there. Based on
# `pre-commit init-templatedir`, with two changes. It has no machine-specific
# python path, and it fails when a repo has a config but pre-commit is missing,
# instead of letting the checks pass unseen. A repo without a config commits
# as usual. The ID line above lets `pre-commit install` recognise and replace
# this file instead of keeping it as a legacy hook.
#
# One file serves every hook type; the type is the name it was installed under.

[ -f .pre-commit-config.yaml ] || exit 0

if ! command -v pre-commit >/dev/null 2>&1; then
	echo "this repo has .pre-commit-config.yaml but pre-commit is not installed" >&2
	exit 1
fi

here="$(cd "$(dirname "$0")" && pwd)"
exec pre-commit hook-impl --config=.pre-commit-config.yaml \
	--hook-type="$(basename "$0")" --hook-dir "$here" -- "$@"
